#!/bin/ash
# Start akars (TPU inference + chassis/arm control) after the UART pads are
# routed.  Invoked by /usr/bin/starry-run-case-tests, which the kernel's
# init.sh runs synchronously before the login shell -- so the daemon has to
# be detached here and this script has to return immediately.
AKARS_HOME="${AKARS_HOME:-/root}"
AKARS_MODEL="${AKARS_MODEL:-yolov8n_tennis_v4.cvimodel}"
AKARS_MOTOR="${AKARS_MOTOR:-/dev/ttyS1}"
AKARS_ARM="${AKARS_ARM:-/dev/ttyS2}"
PIDFILE=/run/akars.pid
LOG=/run/akars.log

[ -x "$AKARS_HOME/akars" ] || exit 0

# Idempotent: a live pidfile means akars is already running.
if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        exit 0
    fi
fi

cd "$AKARS_HOME" || exit 1
setsid nohup ./akars "$AKARS_MODEL" --motor "$AKARS_MOTOR" --arm "$AKARS_ARM" \
    >>"$LOG" 2>&1 </dev/null &
echo $! >"$PIDFILE"
exit 0
